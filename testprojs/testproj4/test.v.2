// 1. PERFECT ANCHOR (Hash will match source exactly)
module anchor_module(input w, input x, output y);
    assign y = w & x;
endmodule

// 2. THE UPDATE (Same name, different logic -> Hash changes)
module math_unit(input a, input b, output c);
    assign c = a + b + 4; // <--- Changed! 
endmodule

//test for addition on an addition
module test_test_test(output a, input b);
    assign a = !b;
endmodule

// 3. THE INSERTION (Completely new module)
module shiny_new_unit(input j, output k);
    wire z;
    test_test_test u1(.a(z), .b(j));
    assign k = ~z;
endmodule

// ROOT MODULE (Hash changes because its children changed)
module top(input in1, input in2, output out1, output out2, output out3);
    anchor_module  u1(.w(in1), .x(in2), .y(out1));
    math_unit      u2(.a(in1), .b(in2), .c(out2));
    shiny_new_unit u4(.j(in1), .k(out3));
endmodule
